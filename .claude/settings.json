{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/usage_check.py start",
            "timeout": 60,
            "statusMessage": "Checking AI usage"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/usage_check.py prompt",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
