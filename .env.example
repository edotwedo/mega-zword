# Mega Zword - Developer Environment Configuration
# Copy this file to .env or export these variables in your shell profile (~/.bashrc, ~/.zshrc).
# Never commit real keys to git!

# 1. OpenRouter (Recommended: access Claude 3.5 Sonnet, DeepSeek V3, GPT-4o, Qwen via one key)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 2. Google AI Studio (Free: 15 requests/minute on Gemini 1.5 Flash at zero cost)
# Get your free key at: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=

# 3. Groq (Ultra-fast Llama inference, generous free tier)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=

# 4. Mistral AI (Optional)
# Get your key at: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=

# 5. NVIDIA NIM / Lightning (Optional free developer credits)
# Get your key at: https://build.nvidia.com/
NVIDIA_API_KEY=

# 6. Local Models (Ollama)
# If you run Ollama locally (https://ollama.com/), Mega Zword detects it automatically
# at http://localhost:11434 with zero configuration needed.
