#!/bin/sh
# Land-gate (Cinder-21, 2026-10-19): nothing reaches main until the suite passes.
# Installed with `megazword gate --install`. Emergency: git push --no-verify
#
# This deliberately depends on nothing but pytest. An earlier version checked
# `import megazword.gate` first and skipped itself on its very first run: the
# venv is an editable install of the MAIN checkout, which did not have the new
# module yet. pytest adds this worktree's own src via pyproject's `pythonpath`,
# so it always tests the tree you are pushing - no install required.
set -u

if [ "${MZ_SKIP_GATE:-}" = "1" ]; then
  echo "land-gate: BYPASS / SKIPPED (MZ_SKIP_GATE=1) - NOTHING WAS VERIFIED"
  exit 0
fi

# git feeds the refs being pushed on stdin. Deleting a branch cannot break the suite,
# and running it anyway cost a four-minute push for nothing (2026-10-19).
saw_any=0
deletes_only=1
push_refs=""
while read -r local_ref _local_sha _remote_ref _remote_sha; do
  [ -n "${local_ref:-}" ] || continue
  saw_any=1
  push_refs="${push_refs}${local_ref} ${_local_sha} ${_remote_ref} ${_remote_sha}
"
  [ "$local_ref" = "(delete)" ] || deletes_only=0
done
if [ "$saw_any" = "1" ] && [ "$deletes_only" = "1" ]; then
  echo "land-gate: delete-only push - no code to verify"
  exit 0
fi

root=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "land-gate: NOTHING WAS VERIFIED - cannot locate repository; push blocked"
  exit 1
}
main="$root"
if common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) && [ -n "$common" ]; then
  main=$(dirname "$common")
fi

# Git Bash uses Windows virtualenvs; POSIX must prefer native executables.
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*) native=Scripts/python.exe; fallback=bin/python ;;
  *) native=bin/python; fallback=Scripts/python.exe ;;
esac
python=""
# MZ_PYTHON is an explicit choice (tests point it at `false` to stop before the
# suite). A bad value must not fall through to the worktree venv, or the suite
# re-enters this hook and the gate recurses.
if [ -n "${MZ_PYTHON:-}" ]; then
  if command -v "$MZ_PYTHON" >/dev/null 2>&1 &&
      "$MZ_PYTHON" -c 'import sys' >/dev/null 2>&1; then
    python="$MZ_PYTHON"
  fi
else
  for candidate in "$root/.venv/$native" "$main/.venv/$native" \
                   "$root/.venv/$fallback" "$main/.venv/$fallback" python3 python; do
    [ -n "$candidate" ] || continue
    if command -v "$candidate" >/dev/null 2>&1 &&
        "$candidate" -c 'import sys' >/dev/null 2>&1; then
      python="$candidate"
      break
    fi
  done
fi
if [ -z "$python" ]; then
  echo "land-gate: NOTHING WAS VERIFIED - no runnable python found on this machine; push blocked"
  exit 1
fi
if ! "$python" -c "import pytest" >/dev/null 2>&1; then
  echo "land-gate: NOTHING WAS VERIFIED - $python has no pytest; push blocked"
  exit 1
fi

# git exports GIT_DIR and friends to its hooks. The suite builds its own throwaway
# repos, and inheriting this environment makes those commands run against THIS repo
# instead (42 errors, caught by the gate on its first real run, 2026-10-19).
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR \
      GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES

cd "$root" || {
  echo "land-gate: NOTHING WAS VERIFIED - cannot enter repository; push blocked"
  exit 1
}

# M2/P3: use THIS worktree's task gate; another checkout's installed code may be old.
# Check before spending the suite, then again after it (leases may change meanwhile).
task_gate() {
  printf '%s' "$push_refs" | PYTHONPATH="$root/src" "$python" -c \
    'from megazword.task import pre_push; raise SystemExit(pre_push())'
}
if ! task_gate; then exit 1; fi

# Ballot P2/A2: docs/MEMORY-INDEX.md is generated, and the gate is what regenerates it, so a
# stale index cannot land. PYTHONPATH points at THIS worktree's src: the venv is an editable
# install of the main checkout, and the last time the hook trusted that it tested the wrong tree.
if PYTHONPATH="$root/src" "$python" -c "from megazword import memory_index; memory_index.write()" \
        >/dev/null 2>&1; then
  if ! git diff --quiet -- docs/MEMORY-INDEX.md; then
    echo "land-gate: docs/MEMORY-INDEX.md was stale; regenerated - commit it and push again"
    exit 1
  fi
fi

# Rules check: Ballot P1/P2. Rules must match approved ballot even on docs-only pushes.
if ! PYTHONPATH="$root/src" "$python" -c \
    'from megazword import rules; ok, msg = rules.check(); raise SystemExit(0 if ok else 1)' >/dev/null 2>&1; then
  echo "land-gate: unvoted rules change in docs/SYSTEM-DRAFT.md; push blocked"
  exit 1
fi

# Docs-only shortcut (Phil directive, 2026-10-30): if every commit being pushed only touches
# documentation or notes, skip the 2,200-test suite (saves ~100s of CPU).
is_doc_only=0
if [ "$saw_any" = "1" ]; then
  can_check_diff=1
  changed_files=""
  while read -r l_ref l_sha r_ref r_sha; do
    [ -n "${l_ref:-}" ] || continue
    [ "$l_ref" != "(delete)" ] || continue
    if [ -z "${r_sha:-}" ] || [ "$r_sha" = "0000000000000000000000000000000000000000" ]; then
      base=$(git merge-base origin/main "$l_sha" 2>/dev/null || git merge-base main "$l_sha" 2>/dev/null) || { can_check_diff=0; break; }
      diff_out=$(git diff --name-only "$base" "$l_sha" 2>/dev/null) || { can_check_diff=0; break; }
    else
      diff_out=$(git diff --name-only "$r_sha" "$l_sha" 2>/dev/null) || { can_check_diff=0; break; }
    fi
    changed_files="${changed_files}
${diff_out}"
  done <<EOF
$push_refs
EOF

  if [ "$can_check_diff" = "1" ]; then
    has_code=0
    saw_files=0
    for f in $changed_files; do
      [ -n "$f" ] || continue
      saw_files=1
      case "$f" in
        docs/SYSTEM-DRAFT.md|docs/RULES.md) has_code=1; break ;;
        docs/*|*.md|*.txt|.gitignore) ;;
        *) has_code=1; break ;;
      esac
    done
    if [ "$saw_files" = "1" ] && [ "$has_code" = "0" ]; then
      is_doc_only=1
    fi
  fi
fi

if [ "$is_doc_only" = "1" ]; then
  if ! task_gate; then exit 1; fi
  echo "land-gate: docs-only push - suite skipped (saved ~100s)"
  exit 0
fi

echo "land-gate: running the suite before this push (a few minutes)"
if "$python" -m pytest -q; then
  if ! task_gate; then exit 1; fi
  echo "land-gate: suite passed"
  exit 0
fi
echo "land-gate: SUITE FAILED - push blocked"
echo "land-gate: a single failure that passes on its own is the known winpty contention"
echo "land-gate: flake (tests/test_terminal_input.py); re-run just that test first"
echo "land-gate: fix it, or 'git push --no-verify' if you are certain it is not you"
exit 1
